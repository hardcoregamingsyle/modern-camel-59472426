; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to key

config_version=5

[application]

config/name="FlightSimulator"
config/description="A lightweight, physics-driven multi-aircraft flight simulator with animated control surfaces, helicopters, and airports."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://assets/textures/icon.svg"
config/driver_driver_name="GLES3"
config/default_locale="en"
config/deterministic_time_step=false

[autoload]

ErrorLogger="*res://scripts/ErrorLogger.gd"
AircraftManager="*res://scripts/AircraftManager.gd"
Main="*res://scripts/Main.gd"

[debug]

gdscript/warnings/deprecated_code=true
gdscript/warnings/deprecated_class_usage=true
gdscript/warnings/unused_signal=true
gdscript/warnings/unused_variable=true
gdscript/warnings/unused_parameter=true
gdscript/warnings/return_value_discarded=true
gdscript/warnings/redundant_await=true
gdscript/warnings/strict_typed_array_declaration=true

default_debugger_flags/stack_trace_on_exception=true
default_debugger_flags/print_stack_on_warning=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/size/maximized=false
window/size/min_width=800
window/size/min_height=600
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/vsync_mode=1
window/always_on_top=false
window/title="Flight Simulator v1.0.0"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/texture_filtering/texture_filter_mipmap_linear=2
renderer/texture_filtering/texture_filter_anisotropic_filtering_level=1
renderer/filters/use_pixel_snap=false
renderer/lighting/shadow_map_size=2048
renderer/lighting/shadow_atlas_size=2048
renderer/lighting/depth_pass_mode=once
renderer/environment/default_environment="res://scenes/environment/default_env.tres"
renderer/rendering_options/max_bounces=2
renderer/rendering_options/sdfgi_use_half_resolution=true
renderer/rendering_options/ssao_enabled=true
renderer/rendering_options/ssao_intensity=1.0
renderer/rendering_options/ambient_light_source=3

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/time_scale=1.0
3d/solver/iterations=10
3d/solver/position_iterations=10
3d/solver/velocity_iterations=10
2d/solver/iterations=10

[input]

move_forward={"deadzone": 0.5, "events": [{"event": "{\"button_index\": 87, \"type\": 1}"}, {"event": "{\"keycode\": 87, \"physical_keycode\": 87, \"type\": 1}"}]}
move_back={"deadzone": 0.5, "events": [{"event": "{\"button_index\": 83, \"type\": 1}"}, {"event": "{\"keycode\": 83, \"physical_keycode\": 83, \"type\": 1}"}]}
move_left={"deadzone": 0.5, "events": [{"event": "{\"button_index\": 65, \"type\": 1}"}, {"event": "{\"keycode\": 65, \"physical_keycode\": 65, \"type\": 1}"}]}
move_right={"deadzone": 0.5, "events": [{"event": "{\"button_index\": 68, \"type\": 1}"}, {"event": "{\"keycode\": 68, \"physical_keycode\": 68, \"type\": 1}"}]}
roll_left={"events": [{"event": "{\"keycode\": 42, \"physical_keycode\": 42, \"type\": 1}"}]}
roll_right={"events": [{"event": "{\"keycode\": 42, \"physical_keycode\": 42, \"type\": 1, \"pressed\": false}"}]}
pitch_up={"events": [{"event": "{\"button_index\": 2, \"type\": 1}"}]}
pitch_down={"events": [{"event": "{\"button_index\": 1, \"type\": 1}"}]}
yaw_left={"events": [{"event": "{\"button_index\": 2, \"type\": 1, \"shift\": true}"}]}
yaw_right={"events": [{"event": "{\"button_index\": 1, \"type\": 1, \"shift\": true}"}]}
reset_view={"events": [{"event": "{\"keycode\": 82, \"physical_keycode\": 82, \"type\": 1}"}]}
toggle_chase_cam={"events": [{"event": "{\"keycode\": 67, \"physical_keycode\": 67, \"type\": 1}"}]}
change_aircraft={"events": [{"event": "{\"keycode\": 69, \"physical_keycode\": 69, \"type\": 1}"}]}
camera_reset={"events": [{"event": "{\"keycode\": 8, \"physical_keycode\": 8, \"type\": 1}"}]}

[layer_names]

3d_physics/layer_1="Aircraft"
3d_physics/layer_2="Ground"
3d_physics/layer_3="Airport"
3d_physics/layer_4="Buildings"
3d_physics/layer_5="Obstacles"
3d_physics/layer_6="UI"
3d_physics/layer_7="Particles"
3d_physics/layer_8="Triggers"

[rendering/environment]

default_clear_color=Color(0.4, 0.6, 0.8, 1)
default_ambient_light_energy=0.5
default_fog_enabled=true
default_fog_density=0.01
default_fog_aerial_perspective_enabled=false

[rendering/anti_aliasing]

method=1
msaa_3d=2
msaa_2d=2
screen_space_aa=0
fxaa_enabled=false

[rendering/debug]

debug/show_collision_shape=false
debug/show_navigation_geometry=false
debug/show_physical_bodies=false

[navigation]

enabled=true

[tls]

certificates/verify_certificate=true
