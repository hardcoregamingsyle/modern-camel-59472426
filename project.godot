[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Terrain"
3d_physics/layer_3="Aircraft"
3d_physics/layer_4="Airport"
3d_physics/layer_5="Camera"
3d_physics/layer_6="Trigger"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
3d/default_gravity=9.8
3d/default_gravity_vector=Vector3(0, -1, 0)

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.36, 0.62, 0.91, 1)

[debug]

gdscript/warnings/unused_parameter=true
gdscript/warnings/unused_variable=true
gdscript/warnings/unused_signal=true
gdscript/warnings/return_value_discarded=false

[editor_plugins]

enabled=PackedStringArray()
