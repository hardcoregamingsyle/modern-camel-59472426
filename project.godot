[layer_names]

3d_physics/layer_1="aircraft"
3d_physics/layer_2="ground"
3d_physics/layer_3="buildings"
3d_physics/layer_4="airport"
3d_physics/layer_5="weather"
3d_physics/layer_6="terrain"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_driver="opengl3"
textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_texture_repeat=0
shadows/scale_shadow_atlas=1
shadows/decal_size=1024
shadows/range_limit=1024
shadows/lights_per_tile=32
shadows/light_map_size=1024
volumetric_fog_enabled=true
volumetric_fog_half_resolution=0
volumetric_fog_msaa=2
glow_enabled=true
glow_intensity=0.8
glow_bloom=0.1
fog_enabled=true
fog_density=0.001
fog_height=0.0
fog_depth_range=1000.0
fog_sun_scatter=0.01
anti_aliasing=1
ssao_enabled=true
ssr_enabled=false
dof_blur_amount=0.1
dof_blur_far=0.0
dof_blur_near=0.0
