[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="aircraft"
3d_physics/layer_3="airport"
3d_physics/layer_4="terrain"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.81
3d/default_linear_slop=0.001
3d/default_angular_slop=0.01

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/glow_enabled=false
environment/ssao_enabled=true
lights/directional_light_shadow_atlas_size=4096
shadows/point_light_shadow_atlas_size=2048
