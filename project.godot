[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="aircraft"
3d_physics/layer_3="terrain"

[physics]

common/physics_ticks_per_second=60
common/enable_pause_aware_picking=true
common/enable_input_events_paused=false

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.webgl="gl_compatibility"
quality/shadows/max_distance=100.0
quality/shadows/directional_light/maximum_distance=100.0
quality/shadows/directional_light/mode=2
quality/screen_space_effects/ssao_enabled=true
quality/screen_space_effects/ssil_enabled=false
